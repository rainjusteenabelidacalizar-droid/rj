    <!-- Services animation styles -->
    <style>
        .services-subtitle {
            font-size: 1.15rem;
            font-weight: 500;
            opacity: 0.85;
        }

        /* ---------- Filter tabs (new) ---------- */
        .services-filters {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 0.6rem;
            margin-bottom: 1.75rem;
        }

        .services-filter {
            border: 0;
            border-radius: 999px;
            padding: 0.4rem 1rem;
            font-size: 0.85rem;
            font-weight: 600;
            color: #222;
            background: #fff;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            cursor: pointer;
            transition: background 0.25s ease, transform 0.25s ease;
        }

        .services-filter:hover {
            transform: translateY(-2px);
        }

        .services-filter.is-active {
            background: #ffc107;
        }

        /* ---------- Expanding service panels (new) ---------- */
        .services-grid {
            display: flex;
            gap: 0.75rem;
            height: 540px;
            margin-top: 1rem;
        }

        .service-item {
            position: relative;
            flex: 1 1 0;
            min-width: 0;
            overflow: hidden;
            border: 0;
            padding: 0;
            text-align: left;
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
            color: #222;
            cursor: pointer;
            opacity: 0;
            transform: translateX(-40px);
            transition: flex-grow 0.55s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.35s ease;
        }

        /* Scroll-triggered entrance, staggered by --i */
        .service-item.in-view {
            animation: serviceSlideIn 0.6s ease forwards;
            animation-delay: calc(var(--i) * 0.12s);
        }

        @keyframes serviceSlideIn {
            from {
                opacity: 0;
                transform: translateX(-40px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .service-item[hidden] {
            display: none;
        }

        .service-item:hover {
            box-shadow: 0 12px 26px rgba(0, 0, 0, 0.15);
        }

        .service-item.is-open {
            flex-grow: 5;
            cursor: default;
            box-shadow: 0 12px 26px rgba(0, 0, 0, 0.15);
        }

        .service-item:focus-visible {
            outline: 3px solid #ffc107;
            outline-offset: 3px;
        }

        /* Service photo banner */
        .service-media {
            position: absolute;
            inset: 0 0 auto 0;
            height: 160px;
            overflow: hidden;
            transition: opacity 0.3s ease;
        }

        .service-media img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* Open panel: show the whole 16:9 photo, no cropping */
        .service-item.is-open .service-media {
            height: auto;
            aspect-ratio: 16 / 9;
        }

        /* Crown & Bridge: two photos that crossfade */
        .service-media.is-fade img:nth-child(2) {
            animation: mediaFade 6s infinite;
        }

        @keyframes mediaFade {

            0%,
            40% {
                opacity: 0;
            }

            50%,
            90% {
                opacity: 1;
            }

            100% {
                opacity: 0;
            }
        }

        /* Collapsed: icon + vertical name */
        .service-rail {
            position: absolute;
            inset: auto 0 1.25rem 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.9rem;
            transition: opacity 0.25s ease;
        }

        .service-rail i {
            font-size: 1.5rem;
            color: #ffc107;
            transition: transform 0.3s ease, color 0.3s ease;
        }

        .service-item:hover .service-rail i {
            transform: rotate(-10deg) scale(1.2);
            color: #e0a800;
        }

        .service-rail span {
            writing-mode: vertical-rl;
            font-weight: 500;
            white-space: nowrap;
            color: #222;
        }

        /* Open: full details */
        .service-detail {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 1rem 1.75rem 1.5rem;
            opacity: 0;
            transform: translateY(12px);
            pointer-events: none;
            transition: opacity 0.3s ease, transform 0.3s ease;
        }

        .service-item.is-open .service-rail {
            opacity: 0;
        }

        .service-item.is-open .service-detail {
            opacity: 1;
            transform: none;
            pointer-events: auto;
            transition-delay: 0.25s;
        }

        .service-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-bottom: 0.8rem;
        }

        .service-tag {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            border-radius: 999px;
            padding: 0.2rem 0.7rem;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .service-tag.is-service {
            background: #ffc107;
            color: #222;
        }

        .service-tag.is-time {
            border: 1px solid #ffc107;
            color: #222;
        }

        .service-detail h3 {
            font-size: 1.75rem;
            font-weight: 700;
            margin: 0 0 0.5rem;
        }

        .service-detail p {
            margin: 0 0 1rem;
            font-size: 0.95rem;
            line-height: 1.5;
            opacity: 0.85;
        }

        .service-foot {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 1rem;
            padding-top: 0.9rem;
            border-top: 1px solid rgba(0, 0, 0, 0.1);
        }

        .service-fee small {
            display: block;
            font-size: 0.7rem;
            opacity: 0.7;
        }

        .service-fee strong {
            font-size: 1.2rem;
            color: #e0a800;
        }
 
        @media (max-width: 767.98px) {
            .services-grid {
                flex-direction: column;
                height: auto;
            }

            .service-item {
                flex: none;
                height: 64px;
                transition: height 0.45s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.35s ease;
            }

            .service-item.is-open {
                height: 500px;
            }

            .service-media {
                height: 130px;
            }

            /* keep the collapsed row readable */
            .service-item:not(.is-open) .service-media {
                opacity: 0;
            }

            .service-detail {
                padding-top: 1rem;
            }

            .service-rail {
                inset: 0;
                flex-direction: row;
                justify-content: flex-start;
                align-items: center;
                padding: 0 1.25rem;
            }

            .service-rail span {
                writing-mode: horizontal-tb;
            }
        }

        @media (prefers-reduced-motion: reduce) {

            .service-item,
            .service-detail,
            .service-rail {
                transition: none;
            }

            .service-media.is-fade img:nth-child(2) {
                animation: none;
                opacity: 0;
            }
        }

        /* Dentist cards pop-in animation */
        .dentist-card {
            opacity: 0;
            transform: scale(0.7);
            transition: transform 0.35s ease, box-shadow 0.35s ease;
        }

        .dentist-card.in-view {
            animation: dentistPopIn 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
            animation-delay: calc(var(--d) * 0.15s);
        }

        @keyframes dentistPopIn {
            0% {
                opacity: 0;
                transform: scale(0.6);
            }

            60% {
                opacity: 1;
                transform: scale(1.08);
            }

            100% {
                opacity: 1;
                transform: scale(1);
            }
        }

        .dentist-card.in-view:hover {
            transform: translateY(-8px) scale(1.03);
            box-shadow: 0 0 0 4px rgba(255, 193, 7, 0.25), 0 14px 30px rgba(0, 0, 0, 0.18);
        }
    </style>
